# -------------------------------------------------------------------
# Public variables (VITE_ prefix) — baked into the client bundle at
# build time. Safe to commit. Never put secrets here.
# -------------------------------------------------------------------
VITE_APP_NAME=claude-start-cf
VITE_APP_VERSION=0.1.0
VITE_PUBLIC_API_URL=https://api.example.com

# -------------------------------------------------------------------
# Server-only variables — NO prefix. Only accessible inside server
# functions (createServerFn). Never exposed to the client bundle.
# -------------------------------------------------------------------
SECRET_API_KEY=
DATABASE_URL=
